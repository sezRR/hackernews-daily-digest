{
  "name": "hackernews-mcp",
  "version": "0.1.0",
  "description": "Daily Hacker News digest by email, with follow-up questions answered by reply, plus an MCP server",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "digest": "node dist/run-digest.js",
    "replies": "node dist/run-replies.js",
    "dev:test": "pnpm run build && node --env-file-if-exists=.env dist/dev-test.js",
    "dev:replies": "pnpm run build && DATABASE_PATH=data/dev.db node --env-file-if-exists=.env dist/run-replies.js",
    "mcp": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run typecheck && vitest run"
  },
  "dependencies": {
    "@effect/ai-openai": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@effect/sql-sqlite-node": "4.1.2",
    "effect": "4.1.2",
    "imapflow": "2.10.0",
    "mailparser": "3.14.1",
    "nodemailer": "10.3.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
