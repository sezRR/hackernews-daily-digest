# Copy to .env (chmod 600). Docker Compose reads it; for local runs use `node --env-file=.env`.

# Required
OPENAI_API_KEY=
# The Gmail account that sends the digest. Replies are read from its mailbox over IMAP.
GMAIL_USER=you@gmail.com
# Needs 2-Step Verification. Create one at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
# Time zone for DIGEST_TIME, for what counts as "today", and for log timestamps.
DIGEST_TIMEZONE=Europe/Lisbon

# When the host's cron runs the digest check, in crontab syntax. Read by `make cron-set`;
# run that again after changing it. Keep it at least every 30 minutes: each run checks
# whether the digest is due and retries failures.
CRON_SCHEDULE=*/30 * * * *

# Optional, with defaults
# DIGEST_TIME=07:30
# Who receives the digest. Only replies from this address are answered. Defaults to GMAIL_USER.
# DIGEST_TO=you@gmail.com
# DIGEST_FROM_NAME=HN digest
# DIGEST_MAX_STORIES=10
# DIGEST_MIN_COMMENTS=10
# DIGEST_MIN_AGE_HOURS=3
# Estimated input tokens per digest call. Lower-ranked comments are left out to fit.
# DIGEST_MAX_INPUT_TOKENS=40000
# Output tokens per digest call, reasoning included. A cut-off answer fails that attempt.
# DIGEST_MAX_OUTPUT_TOKENS=8000
# OPENAI_MODEL=gpt-6-luna
# REPLY_POLL_SECONDS=60
# Folder to read replies from. Default: Gmail's All Mail, found by its special-use flag.
# IMAP_MAILBOX=[Gmail]/All Mail
# Tokens per UTC day that answers may spend before new questions are refused.
# Input read from OpenAI's prompt cache counts as a tenth of a token, matching its price.
# CHAT_DAILY_TOKEN_LIMIT=2000000
# Set by the Docker image. Only needed for local runs. `pnpm dev:test` always uses data/dev.db.
# DATABASE_PATH=data/hackernews.db
